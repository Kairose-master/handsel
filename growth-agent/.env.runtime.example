# Runtime: Node 22.16+; copy to .env. No credentials are committed.
# GROWTH_ADMIN_TOKEN is generated/appended by the quickstart; do not leave a duplicate empty assignment.
GROWTH_HOST=127.0.0.1
GROWTH_PORT=4318
GROWTH_DATA_DIR=./data
GROWTH_APPROVAL_REQUIRED=true
# Two independent gates. Leave both unchanged for the first run.
GROWTH_DRY_RUN=true
GROWTH_SEND_ENABLED=false
GROWTH_SEND_DAILY_CAP=5
# A persistent scheduler checks approved messages every minute and scouts every 6h.
GROWTH_TICK_SECONDS=60
GROWTH_SCOUT_INTERVAL_SECONDS=21600
GROWTH_MAX_REPOS_PER_CYCLE=10
GROWTH_MAX_LEADS=1000
GROWTH_MIN_SCORE=60
GROWTH_EXCLUDE_OWNERS=Kairose-master
GROWTH_QUERIES='["MCP agent language:TypeScript archived:false fork:false","LangGraph agent language:Python archived:false fork:false"]'
GITHUB_TOKEN=
HANDSEL_BASE_URL=https://handsel-main.vercel.app
# Optional bounded local-model research. No tool access or send authority.
GROWTH_OLLAMA_URL=
GROWTH_OLLAMA_MODEL=
GROWTH_MAX_MODEL_CALLS_PER_CYCLE=3
# Optional Resend sender: must be your verified domain. Replies go to a monitored inbox.
RESEND_API_KEY=
GROWTH_FROM=
GROWTH_REPLY_TO=
