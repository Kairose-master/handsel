{
  "manifest_version": 3,
  "name": "Handsel Spend Controls",
  "description": "See and manage spending limits for your Handsel agents.",
  "version": "0.1.0",
  "permissions": ["identity", "storage"],
  "host_permissions": [
    "https://handsel-main.vercel.app/*",
    "https://handsel-nu.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "Handsel Spend Controls",
    "default_popup": "popup.html"
  }
}
