# Loaded automatically from the current working directory. Existing environment values win.
# Optional GitHub token; keep this file copied as .env, never commit a real token.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
HANDSEL_BASE_URL=https://handsel-main.vercel.app
GROWTH_DATA_DIR=./data
# Positive integer; counts approvals per UTC day, not delivered messages.
GROWTH_DAILY_CAP=20
# Cannot be disabled. This tool never sends messages, even after approval.
GROWTH_APPROVAL_REQUIRED=true
