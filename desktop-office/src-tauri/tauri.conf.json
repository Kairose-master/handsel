{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Handsel Office",
  "version": "0.1.0",
  "identifier": "com.handsel.office",
  "build": {
    "frontendDist": "https://handsel-main.vercel.app"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Handsel Office",
        "url": "https://handsel-main.vercel.app/office",
        "width": 1180,
        "height": 820,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
