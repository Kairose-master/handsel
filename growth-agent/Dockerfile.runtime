FROM node:22-bookworm-slim
WORKDIR /app
COPY --chown=node:node package.json ./
COPY --chown=node:node src/core.js src/config.js ./src/
COPY --chown=node:node ops/ ./ops/
RUN mkdir -p /app/data && chown node:node /app/data
USER node
ENV NODE_ENV=production GROWTH_HOST=0.0.0.0 GROWTH_DATA_DIR=/app/data
EXPOSE 4318
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD node -e "fetch('http://127.0.0.1:4318/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "ops/main.mjs", "serve"]
