# Copy to .env and fill in your OWN paper-trading (모의투자) credentials from
# KIS Developers (https://apiportal.koreainvestment.com) — never your real
# account's app key/secret. See README.md for how to apply for paper trading.

KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=

# Only needed for kis_account_balance — your paper account's 8-digit number
# and 2-digit product code (the two parts of the 8-2 account number KIS
# shows you, e.g. 12345678-01 -> CANO=12345678 PRDT_CD=01).
KIS_PAPER_ACCT_CANO=
KIS_PAPER_ACCT_PRDT_CD=01

# A long random string YOU generate (e.g. `openssl rand -hex 32`) — this is
# what you'll paste into Handsel's "Hire a template office" dialog as the
# auth header (Bearer <this value>), not a KIS credential.
MCP_ACCESS_TOKEN=

MCP_HOST=0.0.0.0
MCP_PORT=8787
MCP_PATH=/mcp
