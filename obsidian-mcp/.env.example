# Copy to .env and fill in.

# From Obsidian: Settings -> Community plugins -> Local REST API -> the API
# key shown there (install the plugin first if you haven't: search
# "Local REST API" in Community Plugins and enable it).
OBSIDIAN_API_KEY=

# Defaults match the plugin's own defaults — only change these if you
# changed the plugin's port/host settings.
OBSIDIAN_PROTOCOL=https
OBSIDIAN_HOST=127.0.0.1
OBSIDIAN_PORT=27124

# A long random string YOU generate (e.g. `openssl rand -hex 32`) — paste
# this into Handsel's "Hire staff" -> "Connect external MCP agent" dialog
# as the auth header (Bearer <this value>), not an Obsidian credential.
MCP_ACCESS_TOKEN=

MCP_HOST=0.0.0.0
MCP_PORT=8788
MCP_PATH=/mcp
