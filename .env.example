# ═══════════════════════════════════════════════════════════════════════════
#  Environment — ordered by BRING-UP, not alphabetically.
#
#  There are a lot of variables here and almost none of them are required.
#  Set TIER 1, deploy, and you have a working app. Every tier after that
#  unlocks one capability and nothing else: an unset variable disables its
#  feature and leaves the rest alone (that is a project convention, see
#  CLAUDE.md "Optional on-chain"). Do not try to fill this file top to bottom
#  in one sitting.
#
#  IMPORTANT: leave a variable UNSET rather than setting it to an empty
#  string. An empty value once parsed as a $0/day spending cap in production
#  and blocked every withdrawal. Empty/zero/garbage now falls back to the
#  default, but do not rely on that.
# ═══════════════════════════════════════════════════════════════════════════


# ─── TIER 1 · REQUIRED. Without these the app does not work. ───────────────

# Neon Postgres. Tables self-migrate on first use, so an empty database is fine.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Signs session cookies. **If this is unset, better-auth falls back to a
# DEFAULT secret** — sessions become forgeable by anyone who knows the
# library's default. It is not optional, and it is easy to miss because the
# app boots without it.  Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public base URL. http://localhost:3000 for dev; the real origin in prod.
BETTER_AUTH_URL=http://localhost:3000

# Encrypts users' stored API keys and agent webhook secrets at rest
# (AES-256-GCM). Rotating it invalidates every stored key — users re-enter
# them, and every BYO-agent webhook secret must be reissued.
# Generate: openssl rand -hex 32
API_KEY_ENCRYPTION_SECRET=

# Your own login email. Superadmin: implicitly holds every permission in the
# access-control matrix. Others are granted specific permissions at
# /admin/access.
ADMIN_EMAIL=


# ─── TIER 2 · The market. Jobs can be posted, worked, and graded. ──────────

# Grading, planning, and delegation all call Claude. Without it, LLM grading
# and the delegation planner are unavailable; test-graded and CI-graded jobs
# still work.
ANTHROPIC_API_KEY=
# Platform-level OpenAI-compatible fallback for the model lane (planning,
# verification, text grading) — the same three values a user's BYOK entry
# stores, e.g. OpenRouter: base URL https://openrouter.ai/api/v1, any
# chat-capable model id. Used when no key above resolves, AND as an
# automatic failover when the Anthropic key fails on billing/auth.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# PREFER_OPENAI_COMPAT=true routes the routine text lane (planning,
# verification, text grading — the bulk of LLM spend) through the compat
# gateway FIRST, with the Anthropic key as automatic failover when the
# gateway is unreachable. Vision grading and i18n stay on the Anthropic key
# either way (Anthropic SDK lanes).
PREFER_OPENAI_COMPAT=
# Platform text-lane model (planner, verifier, text grader). Default
# claude-opus-4-8; set e.g. claude-sonnet-5 to cut that lane's cost ~60%.
PLATFORM_LLM_MODEL=

# Set true to REQUIRE every user to bring their own key — the right setting
# for a public deployment, because otherwise their runs bill your key.
REQUIRE_USER_API_KEY=false

# The Python worker runtime, if you run one. Workers connected over MCP or the
# desktop miner do not need this.
AGENT_RUNTIME_URL=http://localhost:8000

# Authenticates BOTH directions of Next.js <-> runtime traffic. Same value
# here and on the runtime host. Per-agent keys supersede it; this is the
# legacy shared fallback (see STRICT_AGENT_KEYS).
# Generate: openssl rand -hex 32
RUNTIME_SHARED_SECRET=

# 'true' stops accepting the shared secret above — per-agent keys only. Turn
# this on once every worker has been reissued a per-agent key.
STRICT_AGENT_KEYS=


# ─── TIER 3 · On-chain. Escrow, settlement, smart accounts. ────────────────
# Leave every one of these unset to run entirely off-chain. See
# contracts/README.md for the deploy runbook and docs/v2-plan.md for which
# chain and why.

ONCHAIN_CHAIN=                   # 'sepolia' | 'giwa-sepolia' | 'base'
ONCHAIN_RPC_URL=                 # read RPC; falls back to SEPOLIA_RPC_URL
SEPOLIA_RPC_URL=                 # legacy name, still read

# ── The escrow token ──────────────────────────────────────────────────────
# NO DEFAULT, ON PURPOSE. On a mainnet a wrong token address is unrecoverable
# — funds approved and transferred to it are simply gone — and a plausible
# constant compiled into the app is exactly how that happens. Paste it
# deliberately, after checking it against the issuer.
#
#   Base mainnet, native USDC issued by Circle:
#     0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
#   Verify on basescan.org and against circle.com before pasting it.
#
#   ⚠ Base ALSO carries USDbC — the older BRIDGED token, at a DIFFERENT
#     address. It is not the same asset. Nothing here can tell you which one
#     you meant; the decimals check below would not catch it either, because
#     both are 6.
#
# On a testnet this is your deployed MockUSDC. MOCK_USDC_ADDRESS is still read
# after USDC_ADDRESS so existing testnet deployments keep working, but the
# name is misleading on a real chain — prefer USDC_ADDRESS everywhere.
USDC_ADDRESS=

# Your explicit confirmation that the ZeroDev project has a spending policy.
# Nothing here can verify it. Without one, sponsored gas is YOUR money,
# spendable by anyone who can cause a UserOperation — and causing one costs
# them nothing. The app refuses to move real money until this is "true".
PAYMASTER_METERED=

# What one sponsored UserOperation actually costs on the target chain, in USD.
# MEASURE it (docs/v2-plan.md makes one full job cycle a step); do not guess.
# Only used to show an allowance in dollars on a diagnostics page — the gate
# itself counts operations, because an operation is countable BEFORE it is
# sent and its cost is not.
GAS_COST_PER_OP_USD=

# The whole sponsorship grant, spent once. Unset means no lifetime ceiling, which
# is right for an operator who tops the paymaster up. Set it when the balance is
# a one-time grant: every OTHER gas budget here is measured over a rolling 24h
# window, and a window cannot see a total — on the day the money runs out they
# all read "within budget" exactly as they did on the first day. An explicit 0 is
# honoured as zero, not treated as unset.
# The user lane stops at 75% of this and degrades to self-pay; the last quarter
# is reachable only by the keeper sweeps, so draining sponsored gas cannot also
# freeze other people's escrow.
# Run with no paymaster at all: every agent kernel pays its own gas from its own
# ETH. Exactly "true" to enable. NOT the same as an exhausted budget — with no
# paymaster the sponsored path is a dead end rather than a fallback, because an
# operation naming a paymaster with no EntryPoint deposit fails with AA21
# whatever this app believes about its budgets.
# On Base an operation is well under a cent, so a kernel holding a dollar of ETH
# works for weeks. What it costs is agents not needing ETH — a UX property.
PAYMASTER_DISABLED=

SPONSOR_GRANT_TOTAL_USD=

# Whether the ceiling above is a total or an allowance that renews. Unset = a
# total, for a grant genuinely spent once. 30 = a monthly allowance, which is
# what "$10 monthly gas sponsorship limit" means: counted as a lifetime total it
# would refuse in month two for money spent in month one. Rolling rather than
# calendar, so it cannot be gamed across a month boundary.
SPONSOR_GRANT_WINDOW_DAYS=

# Per rolling day, across all agents. Defaults 5 and 2. Size them against the
# grant above, not against a wallet: at Base mainnet prices (~$0.006 a UserOp)
# the defaults are ~1,200 operations a day.
USER_LANE_GAS_BUDGET_USD=
KEEPER_LANE_GAS_BUDGET_USD=

# Per single agent per rolling day (default 0.5) — a Sybil's whole point is not
# being traced to one user, so the per-user cap alone bites too late.
AGENT_GAS_BUDGET_USD=

# What one sponsored UserOp is assumed to cost when metering the budgets above
# (default 0.01). Over-estimating degrades to self-pay sooner, which is the
# safe direction. Distinct from GAS_COST_PER_OP_USD, which only feeds the
# diagnostics display.
USER_OP_COST_USD=

# The paymaster, when it is not the bundler's.
#
# ERC-7677 endpoint (pm_getPaymasterStubData / pm_getPaymasterData). Set this to
# sponsor through something other than ZeroDev — on Base, CDP's paymaster is on
# the same chain as the market. The bundler stays ZERODEV_RPC; the two are
# separate services that were only ever coupled by sharing one URL, and the
# Kernel account does not care who signs the sponsorship.
#
# Order: PAYMASTER_DISABLED wins, then this, then ZERODEV_RPC. Unset changes
# nothing.
#
# Whatever you set, the endpoint needs a contracts allowlist containing the
# market and registry, so it can only be filled in after they are deployed.
PAYMASTER_RPC=

# The bundler, whoever runs it. BUNDLER_RPC wins; ZERODEV_RPC below is the
# legacy name and still works.
#
# Bundling is required even when somebody else sponsors — without a bundler
# there is no ERC-4337 at all. CDP serves BOTH from one url, so on Base the
# usual setup is the same value in this and PAYMASTER_RPC:
#   https://api.developer.coinbase.com/rpc/v1/base/<key>
BUNDLER_RPC=

# ERC-4337. THE WHOLE STACK IS GAS-SPONSORED SMART ACCOUNTS: without a bundler
# there is no degraded mode, there is no product. Also set a spending policy on
# the ZeroDev project before anyone but you can trigger a UserOperation —
# sponsored gas on a real chain is your money, spendable by anyone who can
# cause an operation (docs/v2-plan.md, paymaster section).
ZERODEV_RPC=

AGENT_OWNER_PRIVATE_KEY=         # EOA owning every agent's Kernel smart account
ORACLE_PRIVATE_KEY=              # EOA publishing credit limits + attestations (needs gas)
DEPLOYER_PRIVATE_KEY=            # only for the deploy scripts; not read at runtime
AGENT_ACCOUNT_MODE=              # 'kernel' (default) | 'eoa' — eoa skips 4337 entirely

# Contract addresses, from the deploy.
LABOR_MARKET_ADDRESS=
MOCK_USDC_ADDRESS=               # legacy alias for USDC_ADDRESS above; testnet only
CREDIT_REGISTRY_ADDRESS=
CREDIT_VAULT_ADDRESS=
VERIFIED_TASK_ESCROW_ADDRESS=
MINIVAULT_ADDRESS=
VEILPOLL_FACTORY_ADDRESS=

# EAS-style attestations. EAS_ADDRESS below is EAS on Sepolia.
EAS_ADDRESS=0xC2679fBD37d54388Ce493F1DB75320D236e1815e
EAS_SCHEMA_UID=                  # register the schema once, paste the UID

# ERC-8004 registries, if you use them.
ERC8004_IDENTITY_ADDRESS=
ERC8004_REPUTATION_ADDRESS=
ERC8004_VALIDATION_ADDRESS=


# ─── TIER 4 · Operations. Background work, email, uploads. ─────────────────

# Protects every operator endpoint and the settlement heartbeat. Vercel Cron
# sends it as a Bearer token automatically; set the same value as a GitHub
# Actions secret for the workflow.
# PREFER the Authorization header over ?secret= — Vercel logs the full request
# path, so a query-string secret ends up in log storage permanently.
CRON_SECRET=

# Transactional email: payout notices, loan lifecycle, claim warnings. Unset
# means those emails silently do not send — which is worse than it sounds,
# because the claim WARNING is what a worker gets before its claim is
# reclaimed.
RESEND_API_KEY=
EMAIL_FROM=                      # a verified sender on your Resend domain

# The Mail Desk's ear (POST /api/mail/inbound). Either one enables the route;
# with neither set it refuses, because an open inbound endpoint lets anyone
# forge "customer" mail from any address.
#
# RESEND_WEBHOOK_SECRET is the signing secret Resend shows when you create the
# webhook (whsec_...), verified as a real Svix HMAC over the raw body — prefer
# it. MAIL_INBOUND_SECRET is the shared-secret fallback for providers that do
# not sign (Postmark, a Cloudflare Email Worker); it travels in ?secret= or the
# X-Mail-Secret header, so treat it like CRON_SECRET above.
RESEND_WEBHOOK_SECRET=
MAIL_INBOUND_SECRET=

# Vercel Blob — job attachments and multi-modal deliverables. Auto-provisioned
# once a Blob store is attached to the project. Unset disables attachments.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Timing knobs. Unset = defaults.
CLAIM_DEADLINE_HOURS=            # how long a worker holds a claim before reclaim
EXHAUSTED_REVIEW_HOURS=          # how long a submission waits before refunding
GOVERNANCE_REVEAL_DAYS=
MINING_CONCURRENCY=              # parallel block-mining slots
MINING_SWEEP_CONCURRENCY=


# ─── TIER 5 · Economics. Caps and fees — defaults are sane. ────────────────
# These are PLATFORM DEFAULTS; each account can set its own within
# WALLET_CAP_HARD_MAX_USD, in Worker Console -> payout settings.

WALLET_MAX_TX_USD=100            # per-transfer cap
WALLET_DAILY_CAP_USD=500         # rolling 24h cap per agent
WALLET_CAP_HARD_MAX_USD=100000   # ceiling a user-set cap may reach
AUTO_APPROVE_MAX_BOUNTY_USD=50   # graded-pass auto-release ceiling; above it, manual approve
PLATFORM_FEE_BPS=200             # posting fee, basis points. 200 = 2%
REGISTER_HOURLY_MAX_USERS=30     # platform-wide new-account throttle
MAX_AGENTS_PER_ACCOUNT=20        # each agent gets a provisioned wallet


# ─── TIER 6 · Optional features. Each is independent. ─────────────────────

# GitHub repo jobs (docs/github-jobs.md). Unset => repo jobs unavailable,
# everything else unaffected. Create the App at github.com/settings/apps with
# Contents R/W · Pull requests R/W · Checks R · Metadata R, and the events
# Pull request, Check suite, Check run.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=          # the WHOLE .pem including BEGIN/END. Never commit it.
GITHUB_WEBHOOK_SECRET=           # every delivery to /api/github/webhook is HMAC-verified
# GitHub sign-in + repository picker — same App (a GitHub App has its own
# client credentials). Set the App's callback to
# https://<host>/api/github/oauth/callback first.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=                 # links users straight to the install page

# The house requester that funds standing demand, and x402 machine payments.
# NOTE for a mainnet deployment: the faucet posts practice work. Do not run it
# where the money is real (docs/v2-plan.md).
X402_JOB_REQUESTER_AGENT_ID=
X402_PAY_TO=
X402_CLIENT_KEY=
FAUCET_ENABLED=                  # OPT-IN: 'true' turns the practice-job faucet on
FAUCET_DISABLED=                 # hard kill switch; always wins over FAUCET_ENABLED
FAUCET_TARGET_OPEN=3
FAUCET_MAX_PER_DAY=15

# Hugging Face inference for image/audio lanes. Unset => those job kinds are
# unavailable; text and code are unaffected.
HF_TOKEN=
HF_IMAGE_ENDPOINT=
HF_AUDIO_ENDPOINT=
HF_AUDIO_VOICE=

# IPFS pinning for work proofs, if you want them off your own infrastructure.
IPFS_PIN_ENDPOINT=
IPFS_PIN_TOKEN=

# Instagram publishing (docs/social/instagram.md). Unset => the Social Desk
# can draft and approve but nothing publishes; everything else unaffected.
# OFFICIAL Graph API only — no session-cookie automation, ever.
#
# The long-lived access token for the professional (Business/Creator)
# account. PREFER storing it in the encrypted platform_secrets KV (key
# 'instagram_access_token', with 'instagram_account_id' beside it) over this
# env var — the KV wins when both are set, and rotating it there needs no
# redeploy. Instagram-Login tokens last 60 days; the queue flips jobs to
# NEEDS_AUTH when it dies rather than retrying a dead token.
INSTAGRAM_ACCESS_TOKEN=
# The IG professional account id (the numeric IG_ID, not the @username).
INSTAGRAM_ACCOUNT_ID=
# Graph API version. Unset => the library default (bumped deliberately).
INSTAGRAM_API_VERSION=
# 'graph.instagram.com' (default — Instagram Login flow) or
# 'graph.facebook.com' (Facebook Login for Business flow).
INSTAGRAM_GRAPH_HOST=

# --- Instagram DM automation (comment-triggered Private Replies) ------------
# The comment-to-DM flow (lib/social/instagram-dm-server.ts): someone comments
# on our own post, the comments webhook fires, and AT MOST one private reply
# goes out per person per campaign, ever. Comment-triggered only — the code
# has no path to DM a non-commenter. Opt-in kill-switch pair; DISABLED always
# wins. Enabling is the standing approval for the MECHANISM; each campaign's
# template is approved separately before it enters social_dm_campaigns.
# Needs instagram_business_manage_messages (Instagram Login) /
# instagram_manage_messages (Facebook Login) on the token.
INSTAGRAM_DM_ENABLED=
INSTAGRAM_DM_DISABLED=
# Random string you invent (openssl rand -hex 24) and ALSO paste into Meta's
# webhook subscription form — the GET handshake compares them.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# The Meta app's App Secret — used ONLY to verify X-Hub-Signature-256 on
# webhook POSTs. Not a token; never sent anywhere.
META_APP_SECRET=

# Weekly contest — REAL money, paid manually by the operator. Only set it if
# you intend to pay. See docs/operations.md.
CONTEST_PRIZE_USD=

# Alternate runtime host, if you run one.
V0_RUNTIME_URL=

# Etherscan verification during contract deploys (build-time only).
ETHERSCAN_API_KEY=


# ─── Set by the host, not by you ──────────────────────────────────────────
# VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL, NODE_ENV — Vercel provides these.
#
# ─── Read by other processes, not by Next.js ──────────────────────────────
# The Python runtime reads ANTHROPIC_API_KEY, ANTHROPIC_MODEL and
# RUNTIME_SHARED_SECRET from its own host. The headless worker script reads
# HANDSEL_PLATFORM_URL, HANDSEL_EMAIL, HANDSEL_PASSWORD,
# HANDSEL_AGENT_ID and HANDSEL_AGENT_SECRET. SOLC_PATH is used only by
# scripts/compile-labor-v2.mjs.

# ─── This deployment's public origin ──────────────────────────────────────
# Used for every generated link: emails, work-proof URLs, the MCP connect
# card, GitHub comments, OG metadata. Falls back to Vercel's own
# VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL, then localhost.
#
# Set it explicitly once there is a custom domain, or whenever the URL users
# should see differs from the one Vercel reports. It used to be a hostname
# typed into eighteen files, which was fine with one deployment and became a
# defect with two.
PUBLIC_ORIGIN=

# ---- Solana devnet port (optional — docs/solana-port.md) ----
# Read path (the /solana board): both required, or the page says "unconfigured".
SOLANA_CLUSTER=devnet
SOLANA_PROGRAM_ID=8C3gbrTv5vriPiEjuS7BukrnxyAFoDYt8BdBCf7W2G6H
# Override the public RPC (rate-limits hard) with a dedicated endpoint if the
# board polls often.
SOLANA_RPC_URL=

# Write path (POST /api/admin/solana-loop — devnet-only by policy, the code
# refuses any real-money cluster). JSON byte array, the id.json format.
# This key pays SOL fees and must be the devnet test mint's authority for the
# demo loop to mint tokens (the deployer keypair from the week-2 deploy is).
SOLANA_OPERATOR_KEYPAIR=

# External job posting (POST /api/jobs/external) on a REAL-MONEY chain.
# Unset = the route is closed there; its testnet pricing ($0.10 buying a $25
# escrowed bounty) is a subsidy that only works because mUSDC is free.
# The price must exceed the bounty — lib/external-job-pricing.ts refuses
# otherwise rather than clamping either number.
# Recommended opening numbers, and why:
#   1.5x is the ratio lib/storefront-pricing.ts already uses ($6/$4, $12/$8,
#   $9/$6) — no reason to invent a second one. $2 sits above what a unit of
#   work actually clears at here (a live 5-role round paid $5.70, ~$1/step)
#   and below the cheapest whole desk ($6), so the product ladder holds. And
#   it bounds the house: EXTERNAL_POST_GLOBAL_PER_DAY is 40, so a $2 bounty
#   risks $80/day of house escrow where the testnet $25 would have risked
#   $1,000. Raising a published price later is easy; cutting one is not.
EXTERNAL_JOB_PRICE_USD=3
EXTERNAL_JOB_BOUNTY_USD=2

# /fleet step one: the public "duplicate this template" link for the Handsel
# Desk table. Notion has no API for publishing a page, so the operator does it
# by hand (Share → Publish → allow duplicating). The published link is the
# default in app/fleet/page.tsx; set this to override it, or to an empty string
# to show the create path (connect_notion_desk create_under_page) instead.
# NEXT_PUBLIC_NOTION_DESK_TEMPLATE_URL=
